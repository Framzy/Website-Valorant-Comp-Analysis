### ============================================================
### VALORANT PREDICTOR V2 - API TESTS
### Base URL: http://localhost:5000
### ============================================================


### =========================================================
### SHARED OPTIONS - YEARS + MAPS
### =========================================================

### 1. Get available years
GET http://localhost:5000/api/options/years
Accept: application/json

# expected
# {
#     "years": [
#         2024,
#         2025,
#         2026
#     ]
# }


###

### 2. Get maps - valid year
GET http://localhost:5000/api/options/maps?year=2024
Accept: application/json

# expected
# {
#   "maps": [
#     "Abyss",
#     "Ascent",
#     "Bind",
#     "Breeze",
#     "Haven",
#     "Icebox",
#     "Lotus",
#     "Split",
#     "Sunset"
#   ],
#   "year": 2024
# }

###

### 3. Get maps - missing year
GET http://localhost:5000/api/options/maps
Accept: application/json

# expected
# {
#   "error": "Year is required."
# }

###

### 4. Get maps - invalid year
GET http://localhost:5000/api/options/maps?year=abc
Accept: application/json

# expected
# {
#   "error": "Year must be an integer."
# }


